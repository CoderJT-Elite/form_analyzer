<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts. The Flutter UI is dark regardless of
         the system theme, so both themes below are dark on purpose: inheriting
         Theme.Light here flashes a white window before the first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Applied once the process has started; also the colour behind the
         Flutter UI while it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
